// SPDX-License-Identifier: GPL-2.0-only
/*
 * Motorola Moto G17 (lamuc), booted from U-Boot chainloaded by stock lk.
 * MT6358 regulators, display on lk's panel init.
 */

/dts-v1/;

#include "mt6768.dtsi"
#include "mt6358.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/adc/mediatek,mt6358-auxadc.h>
#include <dt-bindings/usb/pd.h>

/ {
	model = "Motorola Moto G17";
	compatible = "motorola,lamuc", "mediatek,mt6768";

	aliases {
		mmc0 = &mmc0;
		mmc1 = &mmc1;
	};

	/* vendor gauge profile battery1_profile_t1 (25 C); battery ID unread */
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion-polymer";
		charge-full-design-microamp-hours = <5200000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4448000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4461000 100>, <4400974 95>, <4349768 90>,
			<4293264 85>, <4232175 80>, <4170600 75>, <4112594 70>,
			<4058013 65>, <4008020 60>, <3946004 55>, <3896000 50>,
			<3864312 45>, <3838800 40>, <3817727 35>, <3799709 30>,
			<3775875 25>, <3752462 20>, <3722573 15>, <3696189 10>,
			<3667100 5>, <3205000 0>;
	};

	/* 10k NTC (vendor table = NCP15XH103), 24k pull-up to 2.8 V */
	battery_ntc: thermistor {
		compatible = "murata,ncp15xh103";
		io-channels = <&pmic_adc MT6358_AUXADC_BAT_TEMP>;
		pullup-uv = <2800000>;
		pullup-ohm = <24000>;
		pulldown-ohm = <0>;
		#thermal-sensor-cells = <0>;
	};

	fuel-gauge {
		compatible = "adc-battery";
		io-channels = <&pmic_adc MT6358_AUXADC_BATADC>;
		io-channel-names = "voltage";
		monitored-battery = <&battery>;
		power-supplies = <&charger>;
	};

	chosen {
		/* lk's second framebuffer page, what the panel scans out */
		framebuffer@77916000 {
			compatible = "simple-framebuffer";
			reg = <0 0x77916000 0 (1080 * 2400 * 4)>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * Stand-ins for MT6358 rails lk leaves on. No PMIC driver yet, so
	 * nothing may switch or retune them.
	 */
	vemc: regulator-vemc {
		compatible = "regulator-fixed";
		regulator-name = "vemc";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	vio18: regulator-vio18 {
		compatible = "regulator-fixed";
		regulator-name = "vio18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* replaced by U-Boot with lk's figure */
	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x3e000000>;
	};
};

/*
 * lk's mblock reservations (recon/lk-memory-map.txt). Listing them here,
 * with no-map, makes U-Boot skip its own copies, which carry no no-map.
 */
&{/reserved-memory} {
	ap-md-c-smem@6e000000 {
		reg = <0x0 0x6e000000 0x0 0x01620000>;
		no-map;
	};
	ap-md-nc-smem@70000000 {
		reg = <0x0 0x70000000 0x0 0x008e0000>;
		no-map;
	};
	md-mem-usage@a2000000 {
		reg = <0x0 0xa2000000 0x0 0x10000000>;
		no-map;
	};
	ccci-tag-mem@9fff0000 {
		reg = <0x0 0x9fff0000 0x0 0x00010000>;
		no-map;
	};
	scp@9f900000 {
		reg = <0x0 0x9f900000 0x0 0x00600000>;
		no-map;
	};
	spm@75510000 {
		reg = <0x0 0x75510000 0x0 0x00010000>;
		no-map;
	};
	framebuffer@76f20000 {
		reg = <0x0 0x76f20000 0x0 0x022e0000>;
		no-map;
	};
	minirdump@4d0f0000 {
		reg = <0x0 0x4d0f0000 0x0 0x00010000>;
		no-map;
	};
	aee-debug-kinfo@4d000000 {
		reg = <0x0 0x4d000000 0x0 0x00010000>;
		no-map;
	};
	tee@79200000 {
		reg = <0x0 0x79200000 0x0 0x05600000>;
		no-map;
	};
	sspm@7eb00000 {
		reg = <0x0 0x7eb00000 0x0 0x000c0000>;
		no-map;
	};
	tee-secmem@7e800000 {
		reg = <0x0 0x7e800000 0x0 0x00200000>;
		no-map;
	};
	atf-log@bff40000 {
		reg = <0x0 0xbff40000 0x0 0x00040000>;
		no-map;
	};
	atf-ramdump@bff80000 {
		reg = <0x0 0xbff80000 0x0 0x00080000>;
		no-map;
	};
	atf@4ce00000 {
		reg = <0x0 0x4ce00000 0x0 0x00060000>;
		no-map;
	};
	log-store@7ebc0000 {
		reg = <0x0 0x7ebc0000 0x0 0x00040000>;
		no-map;
	};
	gz-log@7ea00000 {
		reg = <0x0 0x7ea00000 0x0 0x00041000>;
		no-map;
	};
	gz@7ec00000 {
		reg = <0x0 0x7ec00000 0x0 0x01400000>;
		no-map;
	};

	/* console zone at +0x20000 is where U-Boot's memlog writes too */
	ramoops@4d010000 {
		compatible = "ramoops";
		reg = <0 0x4d010000 0 0xe0000>;
		record-size = <0x10000>;
		console-size = <0x40000>;
		pmsg-size = <0x80000>;
	};
};

&cci {
	proc-supply = <&mt6358_vproc12_reg>;
	sram-supply = <&mt6358_vsram_proc12_reg>;
};

/* vendor's top CCI OPP; the dtsi's 1277 MHz @ 1006 mV is not in the k68 tables */
&opp2_15 {
	opp-hz = /bits/ 64 <1187000000>;
	opp-microvolt = <943750>;
};

&cpu0 {
	proc-supply = <&mt6358_vproc12_reg>;
	sram-supply = <&mt6358_vsram_proc12_reg>;
};

&cpu1 {
	proc-supply = <&mt6358_vproc12_reg>;
	sram-supply = <&mt6358_vsram_proc12_reg>;
};

&cpu2 {
	proc-supply = <&mt6358_vproc12_reg>;
	sram-supply = <&mt6358_vsram_proc12_reg>;
};

&cpu3 {
	proc-supply = <&mt6358_vproc12_reg>;
	sram-supply = <&mt6358_vsram_proc12_reg>;
};

&cpu4 {
	proc-supply = <&mt6358_vproc12_reg>;
	sram-supply = <&mt6358_vsram_proc12_reg>;
};

&cpu5 {
	proc-supply = <&mt6358_vproc12_reg>;
	sram-supply = <&mt6358_vsram_proc12_reg>;
};

&cpu6 {
	proc-supply = <&mt6358_vproc11_reg>;
	sram-supply = <&mt6358_vsram_proc11_reg>;
};

&cpu7 {
	proc-supply = <&mt6358_vproc11_reg>;
	sram-supply = <&mt6358_vsram_proc11_reg>;
};

/* eMMC, conservatively: high speed only, no hw reset, no CQE */
&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_default_pins>;
	pinctrl-1 = <&mmc0_default_pins>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	hs400-ds-delay = <0x12814>;
	non-removable;
	no-sd;
	no-sdio;
	vmmc-supply = <&vemc>;
	vqmmc-supply = <&vio18>;
	status = "okay";
};

/* microSD, conservatively: high speed only */
/* pins muxed by the bootloader, as in the vendor DT */
&i2c6 {
	clock-frequency = <400000>;
	status = "okay";

	/*
	 * CPS8851, an RT1711H-style TCPC (VID 0x315c). The vendor DT puts it
	 * at 0x4a and an sc2150 at 0x4e; on this unit only 0x4e answers, with
	 * the CPS8851 IDs.
	 */
	typec@4e {
		compatible = "convenientpower,cps8851";
		reg = <0x4e>;
		interrupts-extended = <&pio 4 IRQ_TYPE_LEVEL_LOW>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			/* sink only until VBUS out (charger boost) is wired up */
			power-role = "sink";
			/* PD hard reset resets the CPS8851's registers; TCPM then loses the port */
			pd-disable;
			typec-power-opmode = "default";
			self-powered;
			data-role = "device";
			sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <10000000>;
		};
	};
};

&i2c7 {
	clock-frequency = <400000>;
	status = "okay";

	/* Suncore CX25890H, a register-compatible BQ25890 clone (same PN) */
	charger: charger@6a {
		compatible = "ti,bq25890";
		reg = <0x6a>;
		interrupts-extended = <&pio 3 IRQ_TYPE_EDGE_FALLING>;
		/* lk leaves it charging; /CE is GPIO150, held low by lk */
		linux,skip-reset;
		/* TS is not the battery NTC: JEITA is battery-thermal's job */
		ti,charge-current = <2048000>;
		ti,battery-regulation-voltage = <4448000>;
		ti,termination-current = <256000>;
		ti,precharge-current = <128000>;
		ti,minimum-sys-voltage = <3500000>;
		ti,boost-voltage = <5126000>;
		ti,boost-max-current = <1650000>;
		#cooling-cells = <2>;
	};
};

&mmc1 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_default_pins>;
	pinctrl-1 = <&mmc1_default_pins>;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	no-mmc;
	no-sdio;
	cd-gpios = <&pio 18 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6358_vmch_reg>;
	vqmmc-supply = <&mt6358_vmc_reg>;
	status = "okay";
};

&pio {
	spi2_pins: spi2-pins {
		pins-spi {
			pinmux = <PINMUX_GPIO25__FUNC_SPI2_CSB>,
				 <PINMUX_GPIO26__FUNC_SPI2_MO>,
				 <PINMUX_GPIO27__FUNC_SPI2_CLK>,
				 <PINMUX_GPIO28__FUNC_SPI2_MI>;
		};
	};

	/* SoC-fixed MSDC0 pins, as on penangf */
	mmc0_default_pins: mmc0-default-pins {
		pins-clk {
			pinmux = <PINMUX_GPIO124__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-cmd-dat {
			pinmux = <PINMUX_GPIO123__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO125__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO132__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO126__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO129__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO127__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO130__FUNC_MSDC0_DAT7>,
				 <PINMUX_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-ds {
			pinmux = <PINMUX_GPIO131__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_4mA>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO133__FUNC_MSDC0_RSTB>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	mmc1_default_pins: mmc1-default-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO164__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO163__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO162__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO161__FUNC_MSDC1_DAT3>,
				 <PINMUX_GPIO170__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO171__FUNC_MSDC1_CLK>;
			drive-strength = <MTK_DRIVE_4mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-insert {
			pinmux = <PINMUX_GPIO18__FUNC_GPIO18>;
			bias-pull-up;
		};
	};
};

&pmic {
	interrupts-extended = <&pio 144 IRQ_TYPE_LEVEL_HIGH>;
};

/* not yet: the codec */
&mt6358codec {
	status = "disabled";
};

/* the PMIC "home" key is Volume Down on this phone */
&mt6358keys {
	/* raw RST_TD code, not seconds: 0 as on stock */
	power-off-time-sec = <0>;

	home {
		linux,keycodes = <KEY_VOLUMEDOWN>;
	};
};

&usb2 {
	/* no Type-C/charger driver to switch roles, so always a gadget */
	dr_mode = "peripheral";
	/delete-property/ usb-role-switch;
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* lk powers it up and sends the init sequence; see recon/dtbo/dtbo0.dts */
	panel@0 {
		compatible = "djn,ft8725";
		reg = <0>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

&dsi_out {
	remote-endpoint = <&panel_in>;
};

&gpu {
	mali-supply = <&mt6358_vgpu_reg>;
	status = "okay";
};

&mt6358_vgpu_reg {
	regulator-max-microvolt = <800000>;
	regulator-coupled-with = <&mt6358_vsram_gpu_reg>;
	regulator-coupled-max-spread = <100000>;
};

/* vendor: vsram = vgpu + 100 mV */
&mt6358_vsram_gpu_reg {
	regulator-min-microvolt = <850000>;
	regulator-max-microvolt = <1050000>;
	regulator-coupled-with = <&mt6358_vgpu_reg>;
	regulator-coupled-max-spread = <100000>;
};

/* the vendor caps MT6768/MT6769 parts at 823 MHz (OPP 7); G85-class go to 1 GHz */
&gpu_opp_table {
	/delete-node/ opp-850000000;
	/delete-node/ opp-875000000;
	/delete-node/ opp-900000000;
	/delete-node/ opp-925000000;
	/delete-node/ opp-950000000;
	/delete-node/ opp-975000000;
	/delete-node/ opp-1000000000;
};

&mipi_tx0 {
	status = "okay";
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_pins>;
	mediatek,pad-select = <0>;
	status = "okay";

	/* touch side of the FT8725 TDDI, firmware already running */
	touchscreen@0 {
		compatible = "focaltech,ft8725-spi";
		reg = <0>;
		spi-max-frequency = <9600000>;
		/* the vendor driver says mode 0, but only mode 3 gets answers */
		spi-cpol;
		spi-cpha;
		interrupts-extended = <&pio 0 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 36 GPIO_ACTIVE_LOW>;
		/* reports display pixels, same orientation (checked with evtest) */
		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&thermal_zones {
	/* vendor JEITA: 4.2 V and less current above 45 C, none above 60 C */
	battery-thermal {
		polling-delay-passive = <5000>;
		polling-delay = <10000>;
		thermal-sensors = <&battery_ntc>;

		trips {
			battery_warm: trip-warm {
				temperature = <45000>;
				hysteresis = <3000>;
				type = "passive";
			};

			battery_hot: trip-hot {
				temperature = <60000>;
				hysteresis = <3000>;
				type = "passive";
			};

			trip-crit {
				temperature = <68000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {
			map-warm {
				trip = <&battery_warm>;
				cooling-device = <&charger 1 2>;
			};

			map-hot {
				trip = <&battery_hot>;
				cooling-device = <&charger 3 3>;
			};
		};
	};
};
