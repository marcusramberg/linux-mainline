/*
 * Display (DPU) bring-up for caiman.
 *
 * The DECON0/DPP/DPU-DMA/DSIM0 topology is defined in zumapro.dtsi; this
 * board section enables it and attaches the caiman (google,gs-km4) panel via
 * a minimal boot-handoff panel driver (google,caiman-panel).
 *
 * The bootloader initialises the DCPHY, DSIM link and panel and leaves the
 * (dual-DSC, command-mode) link streaming - that is what the simple-
 * framebuffer splash draws into. The DECON DRM stack takes over scanning its
 * own framebuffer into that running link (the DECON emits the matching
 * dual-DSC stream). Disable the simple-framebuffer (and the decon-autorefresh
 * mmio-init) before relying on the DECON output, since enabling decon0 runs
 * decon_reset() and tears the bootloader splash down.
 */
&decon0 {
	status = "okay";
};

&dpu_dma {
	status = "okay";
};

/*
 * DP alt mode output: DECON1 into the DP link. Enabling both at once reset
 * the SoC five times over, early enough that neither ramoops nor the journal
 * caught anything, so they come back one at a time.
 *
 * DECON1 first, with nothing attached to it: it comes up as a second CRTC
 * beside the live panel pipe and the two share the window and sub register
 * blocks, which is the half of the pair that can be tested without the DP
 * driver running at all. The DPOSC divider reads 39.936MHz, so the clock
 * definitions are sound, but nothing has enabled those gates yet.
 *
 * The DP node also still does not match its driver: it wants reg-names
 * "link_base" and "phy_base", and phy_base is the combo PHY range that
 * usbdrd31_phy owns. That has to be settled before it is enabled again.
 */
&decon1 {
	status = "okay";
};

&dp {
	status = "disabled";
};

&dpp0 {
	status = "okay";
};

&dsim0 {
	status = "okay";

	panel0: panel@0 {
		compatible = "google,caiman-panel";
		reg = <0>;
		/* DDIC reset for cold power-on (unused on boot handover) */
		reset-gpios = <&gpp0 0 GPIO_ACTIVE_HIGH>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&dsim0_out>;
			};
		};
	};

	ports {
		port@1 {
			reg = <1>;
			dsim0_out: endpoint {
				remote-endpoint = <&panel0_in>;
			};
		};
	};
};
