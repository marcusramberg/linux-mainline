/dts-v1/;

#include "zumapro-pixel-common.dtsi"
#include "zumapro-caimito-bcm4390.dtsi"
#include "zumapro-caimito-s5400.dtsi"
#include "zumapro-caimito-cs35l41.dtsi"

/ {
	model = "Pixel 9 Pro";
	compatible = "google,caiman", "google,zumapro-caiman", "google,zumapro";

	memory_4: memory@a00000000 {
		device_type = "memory";
		reg = <0x0a 0x00 0x80000000>;
	};

	memory_5: memory@a80000000 {
		device_type = "memory";
		reg = <0x0a 0x80000000 0x80000000>;
	};

	memory_6: memory@b00000000 {
		device_type = "memory";
		reg = <0x0b 0x00 0x80000000>;
	};

	memory_7: memory@b80000000 {
		device_type = "memory";
		reg = <0x0b 0x80000000 0x60f83000>;
	};
};

/* Board identity the AOC firmware reads at boot. */
/*
 * The Halo DSP speaker-protection tuning is specific to this board's drivers
 * and to each channel, so the firmware has to be named for both.  This is what
 * wm_adsp interpolates as the system name: the amplifiers ask for
 * cirrus/cs35l41-dsp1-spk-prot-caiman.wmfw, and for a tuning of the same stem
 * with "-r" appended on the right-hand amplifier, which carries the prefix.
 */
&cs35l41_l {
	cirrus,subsystem-id = "caiman";
};

&cs35l41_r {
	cirrus,subsystem-id = "caiman";
};

&aoc {
	aoc-board-id = <0x40902>;
	aoc-board-rev = <0x10000>;
};

