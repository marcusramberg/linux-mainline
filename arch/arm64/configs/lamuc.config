# Moto G17 bring-up on top of mt6768_defconfig
CONFIG_LOCALVERSION="-lamuc"
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_PANIC_TIMEOUT=0
# g_cdc: shell on ttyGS0 (ttyACM on the host) plus ECM ethernet. No
# g_multi: its mass storage LUN times out on the host, which then resets
# the whole device every 10-30 s (U-Boot's ums does mass storage instead)
# CONFIG_USB_ETH is not set
CONFIG_USB_CDC_COMPOSITE=y
CONFIG_POWER_RESET_MT6358=y
CONFIG_EXFAT_FS=y
# intermittent early hard hangs end in a silent watchdog reset; panic instead
# so ramoops keeps a dump
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
# readable fbcon on 1080x2400: fbcon=font:TER16x32 (boot-kernel.sh)
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_CHARGER_BQ25890=y
CONFIG_DRM_PANEL_DJN_FT8725=y
CONFIG_TOUCHSCREEN_FOCALTECH_SPI=y
# systemd sandboxing (PrivateUsers= etc.; upower fails without user ns)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SENSORS_NTC_THERMISTOR=y
CONFIG_MEDIATEK_MT6358_FGADC=y
# CONFIG_MTK_CONSYS is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_CFG80211_WEXT=y
# compressed swap in RAM (NixOS zramSwap)
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_BMI323=y
CONFIG_BMI323_SPI=y
CONFIG_LTR569=y
CONFIG_QMC6308=y
