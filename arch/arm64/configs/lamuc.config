# Moto G17 bring-up on top of mt6768_defconfig
CONFIG_LOCALVERSION="-lamuc"
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_PANIC_TIMEOUT=0
# g_cdc: shell on ttyGS0 (ttyACM on the host) plus ECM ethernet. No
# g_multi: its mass storage LUN times out on the host, which then resets
# the whole device every 10-30 s (U-Boot's ums does mass storage instead)
# CONFIG_USB_ETH is not set
CONFIG_USB_CDC_COMPOSITE=y
# built in, MUSB/T-PHY probe at ~0.2 s and hang the boot; loaded from the
# initramfs /init they work
CONFIG_PHY_MTK_TPHY=m
CONFIG_USB_MUSB_HDRC=m
CONFIG_USB_MUSB_MEDIATEK=m
# Inventra DMA hangs the SoC silently once the host starts bulk traffic
# (always with g_multi mass storage, 1 in 4 boots with g_cdc)
# CONFIG_USB_INVENTRA_DMA is not set
CONFIG_MUSB_PIO_ONLY=y
CONFIG_POWER_RESET_MT6358=y
CONFIG_EXFAT_FS=y
# intermittent early hard hangs end in a silent watchdog reset; panic instead
# so ramoops keeps a dump
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
# readable fbcon on 1080x2400: fbcon=font:TER16x32 (boot-kernel.sh)
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
